[{"pattern_es": "Quiero + [名詞 / 原形動詞]", "pattern_zh": "我想要...", "note": "表達想要的東西或想做的事", "examples": [{"es": "Quiero un café.", "zh": "我想要一杯咖啡。", "en": "I want a coffee."}, {"es": "Quiero aprender español.", "zh": "我想學西班牙語。", "en": "I want to learn Spanish."}], "template": "Quiero 〜.", "subs": ["un café", "aprender español", "ayuda", "ir al baño"]}, {"pattern_es": "Necesito + [名詞 / 原形動詞]", "pattern_zh": "我需要...", "note": "表達需求", "examples": [{"es": "Necesito ayuda.", "zh": "我需要幫助。", "en": "I need help."}, {"es": "Necesito ir al baño.", "zh": "我需要上廁所。", "en": "I need to go to the bathroom."}], "template": "Necesito 〜.", "subs": ["ayuda", "ir al baño", "más tiempo", "un médico"]}, {"pattern_es": "¿Puedo + 原形動詞?", "pattern_zh": "我可以...嗎？", "note": "禮貌請求許可", "examples": [{"es": "¿Puedo entrar?", "zh": "我可以進去嗎？", "en": "Can I come in?"}, {"es": "¿Puedo pagar con tarjeta?", "zh": "我可以刷卡付款嗎？", "en": "Can I pay by card?"}], "template": "¿Puedo 〜?", "subs": ["entrar", "pagar con tarjeta", "usar el baño", "tomar una foto"]}, {"pattern_es": "Me gusta(n) + [名詞]", "pattern_zh": "我喜歡...", "note": "單數用 gusta，複數名詞用 gustan", "examples": [{"es": "Me gusta el café.", "zh": "我喜歡咖啡。", "en": "I like coffee."}, {"es": "Me gustan las frutas.", "zh": "我喜歡水果。", "en": "I like fruits."}]}, {"pattern_es": "¿Dónde está...?", "pattern_zh": "...在哪裡？", "note": "詢問地點", "examples": [{"es": "¿Dónde está el baño?", "zh": "廁所在哪裡？", "en": "Where's the bathroom?"}, {"es": "¿Dónde está la estación?", "zh": "車站在哪裡？", "en": "Where's the station?"}], "template": "¿Dónde está 〜?", "subs": ["el baño", "la estación", "el hotel", "la farmacia"]}, {"pattern_es": "¿Cuánto cuesta...?", "pattern_zh": "...多少錢？", "note": "詢問價格", "examples": [{"es": "¿Cuánto cuesta esto?", "zh": "這個多少錢？", "en": "How much is this?"}, {"es": "¿Cuánto cuesta el boleto?", "zh": "票多少錢？", "en": "How much is the ticket?"}], "template": "¿Cuánto cuesta 〜?", "subs": ["esto", "el boleto", "la habitación", "el vestido"]}, {"pattern_es": "Voy a + 原形動詞", "pattern_zh": "我要去做...", "note": "表達近未來的計畫", "examples": [{"es": "Voy a comer.", "zh": "我要去吃飯。", "en": "I'm going to eat."}, {"es": "Voy a viajar mañana.", "zh": "我明天要去旅行。", "en": "I'm going to travel tomorrow."}], "template": "Voy a 〜.", "subs": ["comer", "viajar mañana", "trabajar", "estudiar español"]}, {"pattern_es": "Tengo que + 原形動詞", "pattern_zh": "我必須...", "note": "表達義務", "examples": [{"es": "Tengo que trabajar hoy.", "zh": "我今天必須工作。", "en": "I have to work today."}, {"es": "Tengo que llamar a mi jefe.", "zh": "我必須打給我老闆。", "en": "I have to call my boss."}], "template": "Tengo que 〜.", "subs": ["trabajar hoy", "llamar a mi jefe", "estudiar", "ir al médico"]}, {"pattern_es": "Hay + [名詞]", "pattern_zh": "有...", "note": "表達存在，單複數同形", "examples": [{"es": "Hay una mesa libre.", "zh": "有一張空桌。", "en": "There's a free table."}, {"es": "¿Hay descuento?", "zh": "有折扣嗎？", "en": "Is there a discount?"}], "template": "Hay 〜.", "subs": ["una mesa libre", "descuento", "wifi aquí", "un problema"]}, {"pattern_es": "¿Qué hora es? / Es la... / Son las...", "pattern_zh": "現在幾點／現在是...點", "note": "一點用 es la，其餘用 son las", "examples": [{"es": "¿Qué hora es? Son las tres.", "zh": "現在幾點？三點。", "en": "What time is it? It's three."}, {"es": "Es la una.", "zh": "現在一點。", "en": "It's one o'clock."}]}, {"pattern_es": "Estoy + [形容詞]", "pattern_zh": "我覺得/我現在...", "note": "表達暫時的狀態或感受", "examples": [{"es": "Estoy cansado.", "zh": "我很累。", "en": "I'm tired."}, {"es": "Estoy feliz hoy.", "zh": "我今天很開心。", "en": "I'm happy today."}], "template": "Estoy 〜.", "subs": ["cansado", "feliz hoy", "nervioso", "preocupado"]}, {"pattern_es": "No entiendo / No hablo bien español", "pattern_zh": "我不懂／我西語說得不好", "note": "溝通卡住時的救命句", "examples": [{"es": "No entiendo, ¿puede repetir?", "zh": "我不懂，可以再說一次嗎？", "en": "I don't understand, can you repeat?"}, {"es": "No hablo bien español todavía.", "zh": "我西語還說得不太好。", "en": "I don't speak Spanish well yet."}]}]